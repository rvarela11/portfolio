{
  "detectRetina": true,
  "interactivity": {
    "detectsOn": "canvas",
    "events": {
      "onClick": {
        "enable": false
      },
      "onHover": {
        "enable": true,
        "mode": "repulse"
      },
      "resize": {
        "enable": true
      }
    },
    "modes": {
      "repulse": {
        "distance": 200,
        "duration": 0.4
      }
    }
  },
  "particles": {
    "links": {
      "color": "#05d9e8",
      "distance": 150,
      "enable": true,
      "opacity": 0.4,
      "width": 1
    },
    "move": {
      "direction": "none",
      "enable": true,
      "outModes": "out",
      "random": false,
      "speed": 4,
      "straight": false
    },
    "number": {
      "density": {
        "enable": true,
        "height": 800,
        "width": 1088
      },
      "value": 80
    },
    "opacity": {
      "value": 0.5
    },
    "paint": {
      "fill": {
        "color": {
          "value": "#d1f7ff"
        },
        "enable": true
      }
    },
    "shape": {
      "type": "circle"
    },
    "size": {
      "value": {
        "max": 3,
        "min": 1
      }
    }
  }
}
